<?xml version="1.0" encoding="utf-8"?>
<!--
  M8's portable distribution (DECISIONS.md D28): ONE self-contained FolderTreeMD.exe that runs on a machine
  with no .NET runtime installed, which the user can copy anywhere and run once.

  The normative command is the one in README.md and PLAN.md (dotnet publish of the app project, Release,
  runtime win-x64, self-contained, PublishSingleFile, EnableCompressionInSingleFile, output to
  artifacts/portable), plus these two settings, measured as necessary to actually get a single file:

    IncludeNativeLibrariesForSelfExtract   WPF ships native libraries (wpfgfx, PresentationNative,
                                           D3DCompiler, PenImc, vcruntime140) that PublishSingleFile leaves
                                           beside the exe by default - measured: 8 files in the output folder
                                           without this switch. It bundles them into the exe; they are
                                           extracted to %TEMP%\.net\<app> on first run, which is how
                                           single-file WPF works.
    DebugType None / DebugSymbols false    without them the publish also writes the app's own .pdb, so the
                                           folder would hold more than the executable.
    AllowedReferenceRelatedFileExtensions  set to "none" so the referenced Core project's .pdb is not copied
                                           into the publish folder either - measured: without it the folder
                                           holds FolderTreeMD.exe plus FolderTreeMD.Core.pdb.

  Apply the profile by name:

    dotnet publish src/FolderTreeMD/FolderTreeMD.csproj -p:PublishProfile=PortableSingleFile

  The output goes to artifacts/portable, which .gitignore excludes.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
